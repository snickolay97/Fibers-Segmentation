# Application sources, tests, launchers and documentation; large data stay local.
/*
!/.gitignore
!/main.py
!/app.py
!/launch_app.cmd
!/launch_app.ps1
!/requirements.txt
!/README.md
!/AGENTS.md
!/docs/
!/test/
!/README_RU.md
!/src/
!/tools/

# Never include generated Python files, environments or local secrets.
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*

# Local scientific audits, derived examples and transcripts stay on this machine.
/docs/*
!/docs/SOLODATA_RELEASE_2026-10-29_RU.md
/test/Fiber Detection.py
